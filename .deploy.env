# NightForge Match Archive — deployment config.
#
# Edit this, then run: bash scripts/deploy-config.sh
# It rewrites the canonical URL, the Open Graph / Twitter image URLs,
# sitemap.xml and robots.txt so they all point at the live domain.
#
# A relative og:image means a shared link renders with NO preview image
# at all, so these have to be absolute.
SITE_URL=https://nightforgeio.github.io/match-archive